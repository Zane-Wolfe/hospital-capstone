# =============================================================
# Hospital Sound Monitor — Environment Configuration
# Copy to .env and fill in real values before starting
# =============================================================

# -------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------
POSTGRES_USER=hospital_user
POSTGRES_PASSWORD=hospital_password
POSTGRES_DB=hospital_monitor

# -------------------------------------------------------------
# InfluxDB
# -------------------------------------------------------------
INFLUXDB_ADMIN_USER=influx_admin
INFLUXDB_ADMIN_PASSWORD=influx_secure_password123
INFLUXDB_ORG=hospital_monitoring_org
INFLUXDB_BUCKET=hospital_sounds
INFLUXDB_TOKEN=my-super-secret-auth-token

# -------------------------------------------------------------
# Backend API
# -------------------------------------------------------------
AUTH_USERNAME=admin
AUTH_PASSWORD=your_secure_password_here
JWT_SECRET_KEY=generate_a_random_256_bit_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sensor API keys — format: sensor_id:api_key,sensor_id:api_key
SENSOR_API_KEYS=sensor_001:key123,sensor_002:key456

# Model
MODEL_PATH=/app/models/hospital_sound_classifier.pth
# Optional: override checkpoint threshold (leave blank to use checkpoint default)
INFERENCE_CONFIDENCE_THRESHOLD=

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_SEGMENT_DURATION_SEC=1.0

# -------------------------------------------------------------
# Grafana
# -------------------------------------------------------------
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_password_here
GRAFANA_SECRET_KEY=generate_a_random_grafana_secret_here

# -------------------------------------------------------------
# Frontend (local development only — not used by Docker)
# -------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
