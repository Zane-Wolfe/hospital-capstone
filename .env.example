# InfluxDB Configuration
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=my-super-secret-auth-token
INFLUXDB_ORG=hospital_monitoring_org
INFLUXDB_BUCKET=hospital_sounds

# Authentication Configuration
AUTH_USERNAME=admin
AUTH_PASSWORD=your_secure_password_here
JWT_SECRET_KEY=generate_a_random_256_bit_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sensor Ingestion
SENSOR_API_KEYS=sensor_001:key123,sensor_002:key456

# Model Configuration
MODEL_PATH=/app/models/hospital_sound_classifier.pth
# Optional: Override confidence threshold (leave blank to use checkpoint default of 0.5)
INFERENCE_CONFIDENCE_THRESHOLD=

# Audio Settings
AUDIO_SAMPLE_RATE=16000
AUDIO_SEGMENT_DURATION_SEC=1.0

# Frontend Configuration (for local development)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
