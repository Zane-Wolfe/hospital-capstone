{
  "description": "Per-sensor inventory table, online/offline status, battery and signal health trends",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Fleet Overview",
      "type": "row"
    },

    {
      "datasource": {"type": "postgres", "uid": "postgres-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "postgres-hospital"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS \"value\" FROM device_metrics",
          "refId": "A"
        }
      ],
      "title": "Total Devices",
      "type": "stat"
    },

    {
      "datasource": {"type": "postgres", "uid": "postgres-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "green", "value": 2}
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "postgres-hospital"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS \"value\" FROM device_metrics WHERE is_online = true",
          "refId": "A"
        }
      ],
      "title": "Online",
      "type": "stat"
    },

    {
      "datasource": {"type": "postgres", "uid": "postgres-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "postgres-hospital"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS \"value\" FROM device_metrics WHERE is_online = false",
          "refId": "A"
        }
      ],
      "title": "Offline",
      "type": "stat"
    },

    {
      "datasource": {"type": "postgres", "uid": "postgres-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 3}
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "postgres-hospital"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS \"value\" FROM device_metrics WHERE battery_percent IS NOT NULL AND battery_percent < 20",
          "refId": "A"
        }
      ],
      "title": "Low Battery",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "title": "Sensor Inventory",
      "type": "row"
    },

    {
      "datasource": {"type": "postgres", "uid": "postgres-hospital"},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "inspect": false
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Status"},
            "properties": [
              {"id": "custom.width", "value": 90},
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "color", "value": {"mode": "thresholds"}},
              {"id": "mappings", "value": [
                {"type": "value", "options": {"Online":  {"text": "Online",  "color": "green", "index": 0}}},
                {"type": "value", "options": {"Offline": {"text": "Offline", "color": "red",   "index": 1}}}
              ]},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}]}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Battery %"},
            "properties": [
              {"id": "unit", "value": "percent"},
              {"id": "decimals", "value": 1},
              {"id": "custom.width", "value": 100},
              {"id": "custom.cellOptions", "value": {"mode": "lcd", "type": "gauge"}},
              {"id": "color", "value": {"mode": "thresholds"}},
              {"id": "min", "value": 0},
              {"id": "max", "value": 100},
              {"id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  {"color": "red",    "value": null},
                  {"color": "yellow", "value": 20},
                  {"color": "green",  "value": 50}
                ]
              }}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Bandwidth (kbps)"},
            "properties": [
              {"id": "unit", "value": "kbps"},
              {"id": "decimals", "value": 1},
              {"id": "custom.width", "value": 130}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Last Heartbeat"},
            "properties": [
              {"id": "custom.width", "value": 160}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Sensor ID"},
            "properties": [{"id": "custom.width", "value": 120}]
          },
          {
            "matcher": {"id": "byName", "options": "Location"},
            "properties": [{"id": "custom.width", "value": 140}]
          }
        ]
      },
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 6},
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": false, "displayName": "Sensor ID"}]
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "postgres-hospital"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  sensor_id AS \"Sensor ID\",\n  COALESCE(location, '—') AS \"Location\",\n  CASE WHEN is_online THEN 'Online' ELSE 'Offline' END AS \"Status\",\n  battery_percent AS \"Battery %\",\n  bandwidth_kbps AS \"Bandwidth (kbps)\",\n  COALESCE(firmware_version, '—') AS \"Firmware\",\n  to_char(last_heartbeat, 'YYYY-MM-DD HH24:MI:SS') AS \"Last Heartbeat\"\nFROM device_metrics\nORDER BY sensor_id",
          "refId": "A"
        }
      ],
      "title": "Device Table",
      "type": "table"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 20},
      "id": 102,
      "title": "Health Trends",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Battery %",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "line"}
          },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",    "value": null},
              {"color": "yellow", "value": 20},
              {"color": "green",  "value": 50}
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "id": 6,
      "options": {
        "legend": {"calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device_heartbeat\")\n  |> filter(fn: (r) => r._field == \"battery_percent\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> yield(name: \"last\")",
          "refId": "A"
        }
      ],
      "title": "Battery Level by Sensor",
      "type": "timeseries"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "dBm",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "line"}
          },
          "mappings": [],
          "max": 0,
          "min": -100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",    "value": null},
              {"color": "yellow", "value": -80},
              {"color": "green",  "value": -70}
            ]
          },
          "unit": "dBm"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "id": 7,
      "options": {
        "legend": {"calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "asc"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device_heartbeat\")\n  |> filter(fn: (r) => r._field == \"signal_strength_dbm\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
          "refId": "A"
        }
      ],
      "title": "WiFi Signal Strength by Sensor",
      "type": "timeseries"
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["hospital", "devices"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Device Status",
  "uid": "hospital-devices",
  "version": 1,
  "weekStart": ""
}
