{
  "description": "Time-series audio levels, event counts by type, confidence trends, and a full event log",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Audio Levels",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "dBFS",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "mappings": [],
          "unit": "dB"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "legend": {"calcs": ["mean", "max", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio_level\")\n  |> filter(fn: (r) => r._field == \"loudness_db\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
          "refId": "A"
        }
      ],
      "title": "Avg Audio Level (dBFS) by Sensor",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 10},
      "id": 101,
      "title": "Event Detection",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Events",
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "mappings": [],
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "alarms"},          "properties": [{"id": "color", "value": {"fixedColor": "#ef4444", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "coughing"},        "properties": [{"id": "color", "value": {"fixedColor": "#f59e0b", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "speech"},          "properties": [{"id": "color", "value": {"fixedColor": "#3b82f6", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "door_knock"},      "properties": [{"id": "color", "value": {"fixedColor": "#8b5cf6", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "door_open_close"}, "properties": [{"id": "color", "value": {"fixedColor": "#6366f1", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "footsteps"},       "properties": [{"id": "color", "value": {"fixedColor": "#6b7280", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "carts_rolling"},   "properties": [{"id": "color", "value": {"fixedColor": "#22c55e", "mode": "fixed"}}]}
        ]
      },
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 11},
      "id": 2,
      "options": {
        "legend": {"calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio_events\")\n  |> filter(fn: (r) => r._field == \"confidence\")\n  |> group(columns: [\"event_type\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: count, createEmpty: false)\n  |> yield(name: \"count\")",
          "refId": "A"
        }
      ],
      "title": "Event Count by Type Over Time",
      "type": "timeseries"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}},
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 11},
      "id": 3,
      "options": {
        "displayLabels": ["percent"],
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "values": ["percent", "value"]},
        "pieType": "pie",
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio_events\")\n  |> filter(fn: (r) => r._field == \"confidence\")\n  |> group(columns: [\"sensor_id\"])\n  |> count()\n  |> group()",
          "refId": "A"
        }
      ],
      "title": "Detections by Sensor",
      "type": "piechart"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 20},
      "id": 102,
      "title": "Detection Confidence",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Confidence",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "line"}
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",    "value": null},
              {"color": "yellow", "value": 0.6},
              {"color": "green",  "value": 0.8}
            ]
          },
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 21},
      "id": 4,
      "options": {
        "legend": {"calcs": ["mean", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio_events\")\n  |> filter(fn: (r) => r._field == \"confidence\")\n  |> group(columns: [\"event_type\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"avg_confidence\")",
          "refId": "A"
        }
      ],
      "title": "Avg Detection Confidence by Event Type",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 29},
      "id": 103,
      "title": "Event Log",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "inspect": false
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "_time"},
            "properties": [
              {"id": "displayName", "value": "Time"},
              {"id": "custom.width", "value": 160}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "sensor_id"},
            "properties": [
              {"id": "displayName", "value": "Sensor"},
              {"id": "custom.width", "value": 110}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "location"},
            "properties": [
              {"id": "displayName", "value": "Location"},
              {"id": "custom.width", "value": 130}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "event_type"},
            "properties": [
              {"id": "displayName", "value": "Event Type"},
              {"id": "custom.width", "value": 140}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "confidence"},
            "properties": [
              {"id": "displayName", "value": "Confidence"},
              {"id": "unit", "value": "percentunit"},
              {"id": "decimals", "value": 2},
              {"id": "custom.width", "value": 110},
              {"id": "custom.cellOptions", "value": {"mode": "lcd", "type": "gauge"}},
              {"id": "color", "value": {"mode": "thresholds"}},
              {"id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  {"color": "red",    "value": null},
                  {"color": "yellow", "value": 0.6},
                  {"color": "green",  "value": 0.8}
                ]
              }}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "loudness_db"},
            "properties": [
              {"id": "displayName", "value": "Loudness"},
              {"id": "unit", "value": "dB"},
              {"id": "decimals", "value": 1},
              {"id": "custom.width", "value": 90}
            ]
          }
        ]
      },
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 30},
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Time"}]
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio_events\")\n  |> pivot(rowKey: [\"_time\", \"sensor_id\", \"location\", \"event_type\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 500)\n  |> keep(columns: [\"_time\", \"sensor_id\", \"location\", \"event_type\", \"confidence\", \"loudness_db\"])",
          "refId": "A"
        }
      ],
      "title": "Event Log",
      "type": "table"
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["hospital", "historical"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Historical Analytics",
  "uid": "hospital-historical",
  "version": 1,
  "weekStart": ""
}
