{
  "description": "High-level overview: event counts, audio levels, device health, and recent detections",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Quick Stats",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio_events\")\n  |> filter(fn: (r) => r._field == \"confidence\")\n  |> group()\n  |> count()",
          "refId": "A"
        }
      ],
      "title": "Total Detections",
      "type": "stat"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]},
          "unit": "dB",
          "decimals": 1,
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["mean"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio_level\")\n  |> filter(fn: (r) => r._field == \"loudness_dba\")\n  |> group()\n  |> mean()",
          "refId": "A"
        }
      ],
      "title": "Avg Audio Level",
      "type": "stat"
    },

    {
      "datasource": {"type": "postgres", "uid": "postgres-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "green", "value": 2}
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "postgres-hospital"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS \"value\" FROM device_metrics WHERE is_online = true",
          "refId": "A"
        }
      ],
      "title": "Online Sensors",
      "type": "stat"
    },

    {
      "datasource": {"type": "postgres", "uid": "postgres-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 3}
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "postgres-hospital"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (\n  (SELECT COUNT(*) FROM device_metrics WHERE is_online = false)\n  +\n  (SELECT COUNT(*) FROM device_metrics WHERE battery_percent IS NOT NULL AND battery_percent < 20)\n) AS \"value\"",
          "refId": "A"
        }
      ],
      "title": "Active Alerts (Offline + Low Battery)",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "title": "Recent Activity",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "inspect": false
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "_time"},
            "properties": [
              {"id": "displayName", "value": "Time"},
              {"id": "custom.width", "value": 160}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "sensor_id"},
            "properties": [
              {"id": "displayName", "value": "Sensor"},
              {"id": "custom.width", "value": 110}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "location"},
            "properties": [
              {"id": "displayName", "value": "Location"},
              {"id": "custom.width", "value": 120}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "event_type"},
            "properties": [
              {"id": "displayName", "value": "Event Type"},
              {"id": "custom.width", "value": 130}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "confidence"},
            "properties": [
              {"id": "displayName", "value": "Confidence"},
              {"id": "unit", "value": "percentunit"},
              {"id": "decimals", "value": 2},
              {"id": "custom.width", "value": 100},
              {"id": "custom.cellOptions", "value": {"mode": "lcd", "type": "gauge"}},
              {"id": "color", "value": {"mode": "thresholds"}},
              {"id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  {"color": "red", "value": null},
                  {"color": "yellow", "value": 0.6},
                  {"color": "green", "value": 0.8}
                ]
              }}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "loudness_dba"},
            "properties": [
              {"id": "displayName", "value": "Loudness"},
              {"id": "unit", "value": "dB"},
              {"id": "decimals", "value": 1},
              {"id": "custom.width", "value": 90}
            ]
          }
        ]
      },
      "gridPos": {"h": 12, "w": 15, "x": 0, "y": 6},
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Time"}]
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio_events\")\n  |> pivot(rowKey: [\"_time\", \"sensor_id\", \"location\", \"event_type\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 50)\n  |> keep(columns: [\"_time\", \"sensor_id\", \"location\", \"event_type\", \"confidence\", \"loudness_dba\"])",
          "refId": "A"
        }
      ],
      "title": "Recent Detections",
      "type": "table"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}},
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 12, "w": 9, "x": 15, "y": 6},
      "id": 6,
      "options": {
        "displayLabels": ["percent", "name"],
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "values": ["percent", "value"]},
        "pieType": "donut",
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio_events\")\n  |> filter(fn: (r) => r._field == \"confidence\")\n  |> group(columns: [\"event_type\"])\n  |> count()\n  |> group()",
          "refId": "A"
        }
      ],
      "title": "Event Type Distribution",
      "type": "piechart"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 102,
      "title": "Events Over Time",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Events",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "normal"}
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 19},
      "id": 7,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "influxdb-hospital"},
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"audio_events\")\n  |> filter(fn: (r) => r._field == \"confidence\")\n  |> group(columns: [\"event_type\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: count, createEmpty: false)\n  |> yield(name: \"count\")",
          "refId": "A"
        }
      ],
      "title": "Detections by Event Type Over Time",
      "type": "timeseries"
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["hospital", "summary"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Summary",
  "uid": "hospital-summary",
  "version": 1,
  "weekStart": ""
}
